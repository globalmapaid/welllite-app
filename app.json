{
  "expo": {
    "name": "welllite",
    "slug": "welllite",
    "scheme": "welllite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wellLite-logo.png",
    "splash": {
      "image": "./assets/wellLite-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.welllite"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.welllite"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/wellLite-logo.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WellLite to use your location."
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
